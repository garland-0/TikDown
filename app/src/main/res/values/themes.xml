<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Forced dark (not DayNight) so the app always matches the intended
         dark neumorphic look regardless of the device's system theme. -->
    <style name="Theme.TikDown" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/neu_background</item>
        <item name="colorPrimary">@color/neu_accent</item>
        <item name="colorAccent">@color/neu_accent</item>
        <item name="android:statusBarColor">@color/neu_background</item>
        <item name="android:navigationBarColor">@color/neu_background</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.TikDown.Transparent" parent="Theme.TikDown">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="Theme.TikDown.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorAccent">@color/neu_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
